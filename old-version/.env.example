# ReviewShield — Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# ─── PostgreSQL ───────────────────────────────────
DATABASE_URL=

# ─── NextAuth ─────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ─── Gmail OAuth ──────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ─── Claude API (Anthropic) ──────────────────────
ANTHROPIC_API_KEY=

# ─── File Storage (S3 / Supabase) ────────────────
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ─── Monitoring ──────────────────────────────────
SENTRY_DSN=

# ─── Internal ────────────────────────────────────
APP_ADMIN_EMAIL=
